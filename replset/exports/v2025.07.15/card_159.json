  "dataset_query": {
    "database": 2,
    "type": "native",
    "native": {
      "template-tags": {},
      "query": "\nselect p.main_cat,\n\t   TO_CHAR(\t   \n\t   (sum(p.profit_year_to_date)-\n\t   sum(p.ytd_prev_year)) /\n   \t   nullif(sum(p.ytd_prev_year),0)\n   \t   * 100, 'FM999 990.00%') AS \"Рост выручки YTD, %\",\n\t   TO_CHAR(\t   \n\t   (sum(p.profit_month_to_date) - \n\t   sum(p.mtd_prev_year)) /\n\t   nullif(sum(p.mtd_prev_year),0)\n\t    * 100, 'FM999 990.00%') AS \"Рост выручки MTD, %\",\n\t   TO_CHAR(\t   \n\t   (sum(p.day_profit) -\n\t   sum(p.day_profit_prev_year)) /\n\t   nullif(sum(p.day_profit_prev_year),0) \n   \t    * 100, 'FM999 990.00%') AS \"Дневн Рост выручки, %\",\n   \t    -- 1. Доля прибыли YTD (Year-to-Date)\n    TO_CHAR(\n        (SUM(p.profit_year_to_date) * 100.0) /\n        NULLIF(SUM(SUM(p.profit_year_to_date)) OVER (), 0),\n        'FM990.00%') AS \"Доля прибыли YTD, %\",\n    -- 2. Доля прибыли MTD (Month-to-Date)\n    TO_CHAR(\n        (SUM(p.profit_month_to_date) * 100.0) /\n        NULLIF(SUM(SUM(p.profit_month_to_date)) OVER (), 0),\n        'FM990.00%') AS \"Доля прибыли MTD, %\" \nfrom replset.mv_combined_all_stores_data p\nwhere report_date = '2025-10-10'\ngroup by p.report_date,\n\t   p.main_cat"
    }
  },
