    "type": "native",
    "native": {
      "template-tags": {},
      "query": "\tselect p2.report_date, \n\t--    p2.shop_name,\n\t\tsum(p2.day_profit) as day_profit,\n\t\tsum(p2.budget_value) as day_budget\n    from replset.mv_combined_all_stores_data p2\n    where --p2.report_date between '2025-09-01' and '2025-09-30' \n\t\tp2.report_date >= date_trunc('month', current_date)\n        and p2.report_date < date_trunc('month', current_date) + interval '1 month'\n    group by report_date\n    order by report_date\n\n"
    }
  },
