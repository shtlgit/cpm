    },
    "type": "native",
    "database": 2,
    "native": {
      "query": "select b.month_year, b.month_budget, p.month_profit \nfrom ( \n\tselect to_char(b2.budget_date, 'MM.YYYY') as month_year,\n\t\tsum(b2.budget_value) as month_budget\n\tfrom replset.mv_everyday_budget_mtd_ytd_by_stores b2\n\twhere b2.budget_date > to_date('31.12.2024', 'DD.MM.YYYY')\n\tgroup by to_char(b2.budget_date, 'MM.YYYY')\n\t) b\nleft join ( \t\n\tselect to_char(p2.report_date, 'MM.YYYY') as month_year,\n\t\tsum(p2.day_profit) as month_profit\n    from replset.mv_everyday_profit_mtd_ytd_by_stores_cat p2\n    where p2.report_date >= date_trunc('year', CURRENT_DATE)\n    group by to_char(p2.report_date, 'MM.YYYY')\n) p\non b.month_year = p.month_year \norder by b.month_year ",
      "template-tags": {}
    }
  },
