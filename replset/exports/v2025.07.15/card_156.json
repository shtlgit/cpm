      "query": "select \nTO_CHAR((sum(profit_year_to_date) -  sum(ytd_prev_year)) / sum(nullif(ytd_prev_year, 0)) * 100, 'FM990.00%') AS \"Рост выручки YTD, %\"\nfrom replset.mv_combined_all_stores_data\nwhere {{actual_date}}\n--c.report_date = '2025-10-10'::date\ngroup by report_date"
