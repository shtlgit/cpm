    "type": "native",
    "database": 2,
    "native": {
      "query": "select to_char(p2.report_date, 'MM.YYYY') as month_year,\n--\tsum(p2.day_profit) as day_profit\n\t--,\n\tsum(p2.day_profit_usd) as day_profit_usd\n\t--,\n--\tsum(p2.profit_month_to_date) as profit_mtd,\n--\tsum(p2.profit_month_to_date_usd) as profit_mtd_usd,\n--\tsum(p2.profit_year_to_date) as profit_ytd,\n--\tsum(p2.profit_year_to_date_usd) as profit_ytd_usd\nfrom replset.mv_everyday_profit_mtd_ytd_by_stores_cat p2\nwhere p2.report_date >= date_trunc('year', CURRENT_DATE)\ngroup by to_char(p2.report_date, 'MM.YYYY')\norder by to_char(p2.report_date, 'MM.YYYY')",
      "template-tags": {}
    }
  },
