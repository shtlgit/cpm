  "dataset_query": {
    "database": 2,
    "type": "native",
    "native": {
      "template-tags": {},
      "query": "select a.month_of_year, a.assets / p.current_liabilities as liquidity_ratio\nfrom\n(select month_of_year, sum(balance_start_month) as assets\nfrom  replset.mv_month_liquidity ml\nwhere ml.account_code in ('1010', '1030', '1050', '1210', '1710')\ngroup by ml.month_of_year) a\nleft join (select ml.month_of_year, -sum(balance_start_month) as current_liabilities\nfrom replset.mv_month_liquidity ml\nwhere ml.account_code in ('3310')\ngroup by ml.month_of_year\n) p\non a.month_of_year = p.month_of_year \nwhere (date('01.'||a.month_of_year) >= DATE_TRUNC('year', CURRENT_DATE))\nAND\n(date('01.'||a.month_of_year) < DATE_TRUNC('year', CURRENT_DATE) + INTERVAL '1 year')\norder by a.month_of_year"
    }
  },
