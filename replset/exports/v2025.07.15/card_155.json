  "dataset_query": {
    "database": 2,
    "type": "native",
    "native": {
      "template-tags": {
        "actual_date": {
          "dimension": [
            "field",
            37152,
            null
          ],
          "widget-type": "date/single",
          "display-name": "Actual Date",
          "type": "dimension",
          "name": "actual_date",
          "id": "5db3310e-fc27-4cff-ae27-6c5aceea30b5",
          "default": null
        }
      },
      "query": "select shop_name as \"Магазин\",\n TO_CHAR((sum(profit_year_to_date) -  sum(ytd_prev_year)) / sum(nullif(ytd_prev_year, 0)) * 100, 'FM990.00%') AS \"Рост выручки YTD, %\",\n TO_CHAR((sum(profit_year_to_date) - sum(ytd_budget)) / sum(ytd_budget) * 100, 'FM990.00%') AS \"Отклонение от Бюджета, %\",\n TO_CHAR((sum(ytd_receipts) - sum(ytd_receipts_prev_year)) / sum(ytd_receipts_prev_year) * 100, 'FM990.00%') AS \"Рост транзакций YTD, %\",\n REPLACE(REPLACE(REPLACE(TRIM(TO_CHAR(sum(profit_year_to_date)/(SUM(ytd_receipts)), '999G999G999G999')),'.', ' '),',',' '),' ', ' ') || ' ₸' AS \"Средний чек YTD, KZT\",\n REPLACE(REPLACE(REPLACE(TRIM(TO_CHAR(sum(profit_year_to_date_usd)/SUM(ytd_receipts), '999G999.99')),' ',' '),',',' '),' ',' ') || ' $' AS \"Средний Чек YTD, USD\",\n REPLACE(REPLACE(REPLACE(TRIM(TO_CHAR(sum(profit_year_to_date), '999G999G999G999')),'.', ' '),',', ' '),' ', ' ') || ' ₸' AS \"Выручка,KZT\"\nfrom replset.mv_combined_all_stores_data\nwhere {{actual_date}} \ngroup by shop_name\n"
    }
  },
