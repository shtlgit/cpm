  "dataset_query": {
    "database": 2,
    "type": "native",
    "native": {
      "template-tags": {},
      "query": "\tselect to_char(p2.report_date, 'MM.YYYY') as month_year,\n\t    p2.main_cat,\n\t\tsum(p2.day_profit) as month_profit\n    from replset.mv_combined_all_stores_data p2\n    where p2.report_date >= date_trunc('year', CURRENT_DATE) and not p2.main_cat  is null\n    group by to_char(p2.report_date, 'MM.YYYY'), p2.main_cat\n    order by month_year, main_cat"
    }
  },
