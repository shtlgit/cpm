  "dataset_query": {
    "type": "native",
    "database": 2,
    "native": {
      "query": "select to_char(p2.sale_date, 'MM.YYYY') as month_year,\n\tsum(p2.daily_receipts) as receipt_count\nfrom replset.mv_everyday_receipt_count_mtd_ytd_by_stores p2\nwhere p2.sale_date >= date_trunc('year', CURRENT_DATE)\ngroup by to_char(p2.sale_date, 'MM.YYYY')\norder by to_char(p2.sale_date, 'MM.YYYY')",
      "template-tags": {}
    }
