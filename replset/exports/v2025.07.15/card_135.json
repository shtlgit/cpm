  "dataset_query": {
    "type": "native",
    "database": 2,
    "native": {
      "query": "\tselect to_char(p2.report_date, 'MM.YYYY') as month_year,\n\t    p2.shop_name,\n\t\tsum(p2.day_profit) as month_profit\n    from replset.mv_combined_all_stores_data p2\n    where p2.report_date >= date_trunc('year', CURRENT_DATE)\n    group by to_char(p2.report_date, 'MM.YYYY'), p2.shop_name\n    order by month_year, shop_name",
      "template-tags": {}
    }
  },
