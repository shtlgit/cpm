      "query": "select\n\treport_date,\n\tshop_name as \"Магазин\",\n\tsum(profit_month_to_date) as \"Выручка MTD,KZT\"\nfrom\n\treplset.mv_combined_all_stores_data\nwhere\n\t{{actual_date}}\ngroup by\n\treport_date,\n\tshop_name\nhaving\n\tsum(profit_month_to_date) is not null\norder by\n\t3 desc\nlimit 5\n;"
    }
