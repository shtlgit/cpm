  "dataset_query": {
    "database": 2,
    "type": "native",
    "native": {
      "template-tags": {},
      "query": "SELECT promo_name,\n       sum(total_new_margin_amount) - sum(purchase_compensation) AS net_promo_profit,\n       avg(new_margin - old_margin) AS avg_margin_change,\n       avg(discount) AS avg_discount\nFROM replset.mvw_promo_analytics\nwhere date_begin > DATE_TRUNC('month', CURRENT_DATE)\nGROUP BY promo_name\nORDER BY net_promo_profit DESC;"
    }
  },
