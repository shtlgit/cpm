  "dataset_query": {
    "info": {
      "card-entity-id": "naO0CnR_3wYfc_aeBX5WG"
    },
    "type": "native",
    "database": 2,
    "native": {
      "query": "select b.month_year, b.shop_name, (p.month_profit - b.month_budget) / b.month_budget * 100 as month_deviation \nfrom ( \n\tselect to_char(b2.budget_date, 'MM.YYYY') as month_year,\n\t\tb2.shop_name,\n\t\tsum(b2.budget_value) as month_budget\n\tfrom replset.mv_everyday_budget_mtd_ytd_by_stores b2\n\twhere b2.budget_date > to_date('31.12.2024', 'DD.MM.YYYY')\n\tgroup by to_char(b2.budget_date, 'MM.YYYY'), b2.shop_name\n\t) b\nleft join ( \t\n\tselect p.month_year, p.shop_name, p.month_profit\n\tfrom ( \n\t\tselect to_char(p2.report_date, 'MM.YYYY') as month_year,\n\t\t\tp2.shop_name,\n\t\t\tsum(p2.day_profit) as month_profit\n\t\tfrom replset.mv_everyday_profit_mtd_ytd_by_stores_cat p2\n\t\tgroup by to_char(p2.report_date, 'MM.YYYY'), p2.shop_name\n\t\t) p\n\t) p\non b.month_year = p.month_year and b.shop_name = p.shop_name \norder by b.month_year ",
      "template-tags": {}
    }
  },
