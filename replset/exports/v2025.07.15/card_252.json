    "native": {
      "template-tags": {},
      "query": "select vendor_name, TO_CHAR(date_begin, 'YYYY-MM') as month_year,\n\tsum(total_new_margin_amount) as total_new_margin_amount\nfrom replset.mvw_promo_analytics\nwhere DATE_TRUNC('year', date_begin) = DATE_TRUNC('year', CURRENT_DATE)\nGROUP BY vendor_name, 2;"
    }
